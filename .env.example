# 로컬은 이 파일을 .env.local 로 복사해 값을 채운다. 운영 값은 Vercel 프로젝트 환경변수에 둔다.

# --- Firebase (브라우저에 그대로 실리는 값) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
# Firebase 가 준 값 그대로 쓴다(chamsu.firebaseapp.com). 구글 로그인 팝업이 이 도메인에서 열린다. 앱 도메인으로 바꾸면 로그인이 404 가 된다
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# 서버가 ID 토큰의 aud·iss 를 확인할 때도 쓴다
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (서버 전용) ---
# 서비스 계정 JSON 을 base64 로 인코딩한 값. 봇 답 쓰기, 관리자 일정 쓰기, scripts/set-admin.mjs 가 쓴다
FIREBASE_SERVICE_ACCOUNT=

# --- MongoDB (서버 전용) ---
# 접속 주소. 경로의 DB 이름(er)을 그대로 쓴다. 봇 사용량 한도와 기억이 여기에 기록한다.
# 한도가 켜져 있어 이 값이 없으면 봇이 답하지 못한다. 컬렉션 접두어는 Vercel 운영 배포에서 er_, 그 밖(로컬·미리보기)에서 er_dev_ 다
MONGODB_URI=

# --- 봇 ---
# Claude API 키(서버 전용)
ANTHROPIC_API_KEY=
# 러너(ask_helper 도구). 비우면 도구 없이 답한다
RUNNER_URL=
RUNNER_TOKEN=
# TypeSafe Jev(기억 고르기·저장, 요청 검사). 비우면 기억을 쓰지 않는다
TYPESAFE_API_KEY=

# --- 이터널리턴 Open API (서버 전용) ---
# 관리자 화면의 시즌 동기화가 쓴다. 없으면 시즌 동기화만 실패한다
ER_API_KEY=
