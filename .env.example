NEXT_PUBLIC_FIREBASE_API_KEY=
# 앱이 열리는 도메인(운영 chamsu.vercel.app, 로컬 localhost:3147). /__/auth/* 는 next.config 가 chamsu.firebaseapp.com 으로 넘긴다
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 서비스 계정 JSON 을 base64 로 인코딩한 값
FIREBASE_SERVICE_ACCOUNT=
# Claude API 키(서버 전용)
ANTHROPIC_API_KEY=
# 러너(ask_helper 도구). 비우면 도구 없이 답한다
RUNNER_URL=
RUNNER_TOKEN=
# TypeSafe Jev(기억 고르기·저장). 비우면 기억을 쓰지 않는다
TYPESAFE_API_KEY=
