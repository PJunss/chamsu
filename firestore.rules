rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // 방 id 는 {uid}_{personaId} 이고 uid 가 요청자면 그 사람의 방이다
    function isRoomOwner(roomId) {
      return signedIn() && roomId.matches(request.auth.uid + '_[a-z0-9]+');
    }
    function validMessage() {
      return request.resource.data.keys().hasOnly(['text', 'nickname', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'nickname', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }
    function validUser() {
      return request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20;
    }

    // 본인만 읽고 쓴다. createdAt 은 만들 때 서버 시각이고 그 뒤로 바뀌지 않는다
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validUser()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validUser()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // 내 일정: 본인만 읽고 쓴다. remindAt 은 startAt − remindMinutes 이고, notifiedAt 은 서버만 채운다
    match /users/{uid}/events/{id} {
      function validMyEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'startAt', 'endAt', 'allDay', 'remindMinutes', 'remindAt', 'notifiedAt', 'via'])
          && d.keys().hasAll(['title', 'startAt', 'endAt', 'allDay', 'remindMinutes', 'remindAt', 'notifiedAt', 'via'])
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
          && d.startAt is timestamp
          && (d.endAt == null || (d.endAt is timestamp && d.endAt > d.startAt))
          && d.allDay is bool
          && (d.remindMinutes == null || d.remindMinutes in [10, 30, 60])
          && (d.remindMinutes == null
            ? d.remindAt == null
            : (d.remindAt is timestamp && d.remindAt == d.startAt - duration.value(d.remindMinutes, 'm')))
          && d.notifiedAt == null
          && d.via == 'app';
      }
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validMyEvent();
    }

    // 방 문서는 clearedAt(/clear 한 시각)만 담는다. 주인만 읽고 쓰기는 서버만 한다
    match /rooms/{roomId} {
      allow read: if isRoomOwner(roomId);
    }
    match /rooms/{roomId}/messages/{id} {
      allow read: if isRoomOwner(roomId);
      allow create: if isRoomOwner(roomId) && validMessage();
    }
    match /rooms/{roomId}/claudeJobs/{id} {
      allow read: if isRoomOwner(roomId);
    }

    // 호감도는 서버만 쓰고, 자기 uid 의 문서만 읽는다
    match /affinity/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 공식 일정은 누구나 읽고 서버만 쓴다
    match /events/{id} {
      allow read: if true;
    }
  }
}
