rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null && request.auth.token.member == true;
    }
    function isSelf(uid) {
      return isMember() && request.auth.uid == uid;
    }

    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'nickname', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'nickname', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname == request.auth.token.nickname
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    match /presence/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'lastSeen'])
        && request.resource.data.keys().hasAll(['nickname', 'lastSeen'])
        && request.resource.data.nickname == request.auth.token.nickname
        && request.resource.data.lastSeen == request.time;
      allow delete: if isSelf(uid);
    }

    match /claudeJobs/{id} {
      allow read: if isMember();
    }
  }
}
